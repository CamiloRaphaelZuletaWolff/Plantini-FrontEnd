# Supabase — https://supabase.com/dashboard/project/<id>/settings/api
# EXPO_PUBLIC_ prefix makes these available in the JS bundle.
# Use the anon/publishable key — NEVER the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Plantini backend (gemini-backend) base URL, WITHOUT /api and without a
# trailing slash. Inlined at build time (required for the web build/Vercel).
# Production: https://plantini-backend.onrender.com
# Local dev: leave empty — the app auto-detects http://<your-LAN-IP>:3000.
EXPO_PUBLIC_GEMINI_BASE_URL=
